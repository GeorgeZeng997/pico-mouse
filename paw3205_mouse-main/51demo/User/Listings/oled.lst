 201   2                      temp=(num/oled_pow(10,len-t-1))%10;
 202   2                      if(enshow==0&&t<(len-1))
 203   2                      {
 204   3                              if(temp==0)
 205   3                              {
 206   4                                      OLED_ShowChar(x+(sizey/2+m)*t,y,' ',sizey);
 207   4                                      continue;
 208   4                              }else enshow=1;
 209   3                      }
 210   2                      OLED_ShowChar(x+(sizey/2+m)*t,y,temp+'0',sizey);
 211   2              }
 212   1      }
